    console.error('Error fetching subscriptions for select:', error);
    return c.json({ success: false, message: 'Failed to fetch subscriptions' }, 500);
  }
});

// GET /subscriptions/grouped - Get grouped subscriptions
subscriptions.get('/grouped', async (c) => {
