// POST /subscriptions/clear-failed - Clear failed subscriptions
subscriptions.post('/clear-failed', async (c) => {
  const user = c.get('jwtPayload');
  const subscriptionService = c.get('subscriptionService');
  const { groupId } = await c.req.json<{ groupId?: string | null }>();

  try {
    const failedSubscriptions = await c.env.DB.prepare(
      'SELECT id FROM subscriptions WHERE user_id = ? AND error IS NOT NULL' +
      (groupId && groupId !== 'all' ? (groupId === 'ungrouped' ? ' AND group_id IS NULL' : ' AND group_id = ?') : '')
    ).bind(...(groupId && groupId !== 'all' && groupId !== 'ungrouped' ? [user.id, groupId] : [user.id])).all<{ id: string }>();

    if (!failedSubscriptions.results || failedSubscriptions.results.length === 0) {
      return c.json({ success: true, message: '该分组内没有检测到失败的订阅。' });
    }

    const idsToDelete = failedSubscriptions.results.map(sub => sub.id);
    const result = await subscriptionService.batchDeleteSubscriptions(user.id, idsToDelete);
    result.message = `成功清除了 ${result.updatedCount || 0} 个失败的订阅。`;

    return c.json(result);
  } catch (error: any) {
    console.error('Error clearing failed subscriptions:', error);
    return c.json({ success: false, message: '清除失败的订阅时出错。' }, 500);
  }
});

