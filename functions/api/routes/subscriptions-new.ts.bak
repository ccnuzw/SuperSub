  const user = c.get('jwtPayload');
  const ruleService = c.get('ruleService');
  const { ruleId } = c.req.param();
  const body = await c.req.json<any>();

  try {
    await ruleService.updateSubscriptionRule(user.id, parseInt(ruleId), body);
    return c.json({ success: true });
  } catch (error: any) {
    console.error('Error updating subscription rule:', error);
    return c.json({ success: false, message: 'Failed to update rule' }, 500);
  }
});

