{
  "name": "supersub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel start:frontend start:backend",
    "start:backend": "wrangler pages dev ./dist --local --persist-to ./.wrangler/state --port 8793",
    "start:frontend": "vite",
    "build": "vite build",
    "build:check": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "db:init": "wrangler d1 execute supersub-db --file=./db/schema.sql --local",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "perf:analyze": "NODE_ENV=analyze vite build",
    "perf:monitor": "npm run dev",
    "perf:test": "lhci autorun",
    "perf:bundle": "npx vite-bundle-analyzer dist --mode json",
    "perf:report": "./scripts/performance.sh report"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.38.4",
    "@types/highlight.js": "^9.12.4",
    "@types/js-yaml": "^4.0.9",
    "@types/uuid": "^10.0.0",
    "@vicons/fluent": "^0.13.0",
    "@vicons/ionicons5": "^0.13.0",
    "@vueuse/core": "^13.9.0",
    "axios": "^1.12.2",
    "bcrypt-ts": "^7.1.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.19",
    "echarts": "^6.0.0",
    "highlight.js": "^11.11.1",
    "hono": "^4.9.8",
    "js-yaml": "^4.1.0",
    "lodash-es": "^4.17.21",
    "naive-ui": "^2.43.1",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.5.0",
    "uuid": "^13.0.0",
    "vfonts": "^0.0.3",
    "vue": "^3.3.4",
    "vue-codemirror": "^6.1.1",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.5.1",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250926.0",
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "^20.14.10",
    "@types/sortablejs": "^1.15.8",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.9.8",
    "cssnano": "^6.0.1",
    "eslint": "^8.57.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-vitest": "^0.3.21",
    "eslint-plugin-vue": "^9.20.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "prettier": "^3.2.5",
    "rollup-plugin-visualizer": "^5.14.0",
    "tailwindcss": "^3.4.17",
    "terser": "^5.19.2",
    "typescript": "~5.5.3",
    "unplugin-vue-components": "^29.1.0",
    "vite": "^5.3.4",
    "vitest": "^1.6.0",
    "vue-tsc": "^2.0.26",
    "wait-on": "^9.0.1",
    "wrangler": "^4.40.1"
  }
}
